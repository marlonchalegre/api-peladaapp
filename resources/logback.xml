<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

  <!-- Disable extensive Jetty debug logs -->
  <logger name="org.eclipse.jetty" level="WARN" />
  <logger name="org.eclipse.jetty.server.HttpChannel" level="WARN" />
  <logger name="org.eclipse.jetty.server.HttpOutput" level="WARN" />
  <logger name="org.eclipse.jetty.server.HttpInput" level="WARN" />
  <logger name="org.eclipse.jetty.util.component.AbstractLifeCycle" level="WARN" />
  
  <!-- Other potentially verbose libraries -->
  <logger name="io.netty" level="WARN" />
  <logger name="com.zaxxer.hikari" level="INFO" />
  <logger name="org.apache.http" level="INFO" />
  <logger name="clj-http" level="INFO" />
</configuration>
